[Unit]
Description=OBD Civic - coletor (ELM327 Bluetooth -> SQLite)
After=bluetooth.target obd-btagent.service
Wants=bluetooth.target obd-btagent.service

[Service]
Type=notify
NotifyAccess=main
User=obd
Group=obd
SupplementaryGroups=bluetooth dialout
WorkingDirectory=/opt/obd
Environment=PYTHONPATH=/opt/obd/src PYTHONUNBUFFERED=1
ExecStart=/opt/obd/venv/bin/python -m obdpi.collector.main
RuntimeDirectory=obd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=always
TimeoutStopSec=8
RestartSec=3
WatchdogSec=90
MemoryMax=180M
Nice=-5

[Install]
WantedBy=multi-user.target
