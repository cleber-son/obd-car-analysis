{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civic-obd",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "civic-obd", "database_id": "92f8939b-914c-4719-b3d0-15d9db1c6319" }],
  "routes": [{ "pattern": "obd.cleberson.social.br", "custom_domain": true }],
  "observability": { "enabled": true }
}
